<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Job Application - Get a Shower</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#132238;background:#f7fbff}
nav{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 5%;background:white}
.logo{font-size:28px;font-weight:700}.links{display:flex;gap:34px;color:#304968}.links span:last-child{color:#1468e8;border-bottom:2px solid #1468e8;padding-bottom:8px}
.hero{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;padding:80px 5%;max-width:1400px;margin:auto}
.kicker{letter-spacing:3px;color:#53739b;font-weight:600;font-size:18px}.hero h1{font-size:72px;line-height:1;margin:18px 0}.hero p{font-size:24px;line-height:1.6;color:#526b89;max-width:650px}
button{background:#1769e8;color:white;border:0;border-radius:10px;padding:20px 30px;font-size:20px;font-weight:700;cursor:pointer}
.card{background:white;border-radius:20px;padding:38px;box-shadow:0 15px 45px #183b5c18}.paper{border:1px solid #d5deea;padding:32px;transform:rotate(1deg);box-shadow:0 8px 25px #00000012}.paper h2{text-align:center;font-size:28px;margin-top:0}.line{height:14px;border-bottom:1px solid #7f8da0;margin:22px 0}
.features{display:flex;justify-content:space-around;padding:45px 5%;background:#eef6ff;text-align:center}.feature{max-width:260px}.feature b{display:block;font-size:20px;margin-bottom:8px}
#application{display:none;padding:70px 5%;max-width:850px;margin:auto}.form{background:white;padding:35px;border-radius:18px;box-shadow:0 10px 35px #0001}.form label{display:block;font-weight:700;margin:20px 0 8px}.form input{width:100%;padding:14px;border:1px solid #c9d5e3;border-radius:8px;font-size:16px}.note{color:#66788e;margin-top:20px}
@media(max-width:800px){.hero{grid-template-columns:1fr}.hero h1{font-size:52px}.features{flex-direction:column;gap:30px;align-items:center}}
</style>
</head>
<body>
<nav><div class="logo">💧 CleanLife</div><div class="links"><span>Home</span><span>About Us</span><span>Careers</span><span>Contact</span></div></nav>

<section class="hero" id="home">
<div>
<div class="kicker">JOIN OUR TEAM</div>
<h1>Get a Shower</h1>
<p>We're looking for motivated individuals who are ready to make a change. Apply now and take the first step towards a cleaner, healthier you!</p>
<button onclick="showApplication()">Start Your Application →</button>
</div>
<div class="card">
<div class="paper">
<h2>JOB APPLICATION</h2>
<strong>Personal Information</strong>
<div class="line"></div><div class="line"></div><div class="line"></div>
<strong>Position Applied For</strong><div class="line"></div>
<strong>Education</strong><div class="line"></div><div class="line"></div>
<strong>Work Experience</strong><div class="line"></div><div class="line"></div>
</div></div>
</section>

<section class="features">
<div class="feature">🚿<b>Better Hygiene</b>Feel fresh and confident</div>
<div class="feature">♡<b>Improved Wellbeing</b>A healthier you</div>
<div class="feature">☺<b>A Brighter Future</b>Small steps make a big difference</div>
</section>

<section id="application">
<h1>Job Application</h1>
<div class="form">
<h2>Get a Shower</h2>
<label>Full Name</label><input placeholder="Your name">
<label>Email Address</label><input placeholder="Your email">
<label>Position Applied For</label><input placeholder="Get a Shower">
<button style="margin-top:25px" onclick="alert('Demo only — no application was submitted.')">Submit Application</button>
<p class="note">Demo page — no information is collected or submitted.</p>
</div>
</section>

<script>
function showApplication(){
 document.getElementById('home').style.display='none';
 document.querySelector('.features').style.display='none';
 document.getElementById('application').style.display='block';
 window.scrollTo(0,0);
}
</script>
</body>
</html>
